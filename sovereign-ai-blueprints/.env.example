# Which blueprint to run. mock | tier1 | tier2 | tier3
SOVEREIGN_TIER=mock

# ---- tier 1: managed API, public model -------------------------------------
MANAGED_API_BASE=https://api.anthropic.com/v1
MANAGED_API_KEY=
MANAGED_MODEL=claude-sonnet-4-6
MANAGED_REGION=eu
DISABLE_PROVIDER_RETENTION=true

# ---- tier 2: private endpoint in your own tenant ---------------------------
# Must be a privatelink / internal hostname. The client refuses a public one.
PRIVATE_ENDPOINT=https://your-account.privatelink.openai.azure.com
PRIVATE_DEPLOYMENT=
PRIVATE_API_VERSION=2024-10-21
PRIVATE_REGION=westeurope

# ---- tier 3: self-hosted open weights --------------------------------------
# Must be loopback or RFC1918. The client refuses a routable address.
SELF_HOSTED_ENDPOINT=http://127.0.0.1:8000/v1
SELF_HOSTED_MODEL=open-weights/instruct

# ---- audit log: always inside your own boundary ----------------------------
AUDIT_LOG_PATH=./var/audit/audit.jsonl
